{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@app/*": ["./app/*"],
      "@platform/*": ["./platform/*"],
      "@ui/*": ["./components/*"],
      "@modules/*": ["./modules/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "components/**/*.ts", "components/**/*.tsx", "modules/**/*.ts", "modules/**/*.tsx", "platform/**/*.ts", "platform/**/*.tsx", "main.tsx", "vite.config.ts"]
}

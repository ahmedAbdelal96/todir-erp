{
  "name": "todir-erp",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "architecture:frontend": "node scripts/architecture/check-frontend-module-boundaries.mjs && node scripts/architecture/verify-frontend-module-fixtures.mjs",
    "architecture:modules": "node scripts/architecture/validate-module-manifests.mjs",
    "database:policy": "node scripts/architecture/validate-database-policy.mjs",
    "api:contract": "node scripts/architecture/validate-openapi.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json && pnpm --dir src/frontend/apps/todir-web typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}

{
  "name": "todir-erp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "test:frontend": "node --test frontend/platform/runtime/runtime-context.test.ts frontend/components/theme/theme.test.ts frontend/components/formatting/formatting.test.ts frontend/components/forms/forms.test.ts frontend/components/primitives/primitives-logic.test.ts frontend/components/design-system.test.ts frontend/modules/directory/tests/party-slice.test.ts frontend/modules/catalog/tests/catalog-slice.test.ts frontend/modules/invoicing/tests/invoicing-slice.test.ts frontend/modules/payments/tests/payments-slice.test.ts frontend/modules/accounting/tests/accounting-slice.test.ts frontend/modules/migration/tests/migration-slice.test.ts frontend/tests/spikes/primitives/primitive-spike.test.ts frontend/tests/spikes/grid/grid-spike.test.ts",
    "architecture:frontend": "node scripts/architecture/check-frontend-module-boundaries.mjs && node scripts/architecture/verify-frontend-module-fixtures.mjs",
    "architecture:modules": "node scripts/architecture/validate-module-manifests.mjs",
    "database:policy": "node scripts/architecture/validate-database-policy.mjs",
    "database:migration-policy": "node scripts/database/validate-migration-policy.mjs",
    "api:contract": "node scripts/architecture/validate-openapi.mjs",
    "api:generate": "node scripts/api/generate-platform-client.mjs",
    "api:drift": "node scripts/api/generate-platform-client.mjs --check",
    "api:breaking": "node scripts/api/check-breaking-contract.mjs",
    "frontend:smoke": "node scripts/verification/frontend-shell-smoke.mjs",
    "release:gates": "node scripts/verification/release-gates.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json && pnpm --dir frontend typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}

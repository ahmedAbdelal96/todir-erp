<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Api</AssemblyName>
    <RootNamespace>Api</RootNamespace>
    <ApiDevelopmentPort Condition="'$(ApiDevelopmentPort)' == ''">5080</ApiDevelopmentPort>
  </PropertyGroup>
  <Target Name="EnsureDevelopmentPortIsFree" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and '$(DisableApiPortCleanup)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Properties\ensure-development-port.ps1&quot; -Port $(ApiDevelopmentPort)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <ProjectReference Include="../Shared/BuildingBlocks/BuildingBlocks.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Modules/Sample/Sample.csproj" />
    <ProjectReference Include="../Modules/Directory/Directory.csproj" />
    <ProjectReference Include="../Modules/FinanceBase/FinanceBase.csproj" />
    <ProjectReference Include="../Modules/Catalog/Catalog.csproj" />
    <ProjectReference Include="../Modules/Pricing/Pricing.csproj" />
    <ProjectReference Include="../Modules/Tax/Tax.csproj" />
    <ProjectReference Include="../Modules/Ledger/Ledger.csproj" />
    <ProjectReference Include="../Modules/Subledger/Subledger.csproj" />
    <ProjectReference Include="../Modules/Invoicing/Invoicing.csproj" />
    <ProjectReference Include="../Modules/Payments/Payments.csproj" />
    <ProjectReference Include="../Modules/Banking/Banking.csproj" />
    <ProjectReference Include="../Modules/Inventory/Inventory.csproj" />
    <ProjectReference Include="../Modules/Sales/Sales.csproj" />
    <ProjectReference Include="../Modules/Purchasing/Purchasing.csproj" />
    <ProjectReference Include="../Modules/Accounting/Accounting.csproj" />
    <ProjectReference Include="../Modules/Hr/Hr.csproj" />
    <ProjectReference Include="../Modules/Payroll/Payroll.csproj" />
    <ProjectReference Include="../Modules/CRM/CRM.csproj" />
    <ProjectReference Include="../Modules/Expenses/Expenses.csproj" />
    <ProjectReference Include="../Modules/POS/POS.csproj" />
    <ProjectReference Include="../Modules/FixedAssets/FixedAssets.csproj" />
    <ProjectReference Include="../Modules/Projects/Projects.csproj" />
    <ProjectReference Include="../Modules/Service/Service.csproj" />
  </ItemGroup>
</Project>

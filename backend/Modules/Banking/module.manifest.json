{
  "$schema": "../../../docs/platform/module-manifest-schema.json",
  "id": "banking",
  "version": "1.0.0",
  "contractsVersion": 1,
  "layer": "L3",
  "type": "module",
  "purchasable": false,
  "scope": "tenant",
  "dependencies": {
    "hard": ["platform-kernel", "directory", "finbase", "ledger", "subledger", "payments", "pos", "payroll", "tax"],
    "optionalCapabilities": ["platform.files"]
  },
  "owns": {
    "schema": "finance_banking",
    "entities": ["treasury_account", "treasury_account_balance_pocket", "bank_account_profile", "cash_account_profile", "digital_wallet_profile", "settlement_account_profile", "treasury_account_change_request", "treasury_account_connection", "statement_import_batch", "external_statement", "external_statement_line", "external_feed_transaction", "bank_originated_event_candidate", "treasury_activity_projection", "treasury_account_balance_projection", "transfer_reconciliation_projection", "settlement_account_projection", "statement_transaction_code_mapping", "reconciliation_rule_set", "reconciliation_rule_version", "reconciliation_session", "reconciliation_match", "reconciliation_match_item", "reconciliation_adjustment", "cash_count", "cash_count_denomination", "cash_difference_resolution", "cash_custodian_history", "cash_position_projection", "cash_forecast_version", "cash_forecast_item", "cash_forecast_projection"]
  },
  "permissions": ["banking.accounts.read", "banking.accounts.create", "banking.accounts.edit", "banking.accounts.activate", "banking.accounts.suspend", "banking.accounts.close", "banking.accounts.sensitive_data.read", "banking.accounts.change.approve", "banking.connections.read", "banking.connections.manage", "banking.statements.read", "banking.statements.import", "banking.statements.validate", "banking.reconciliation.read", "banking.reconciliation.match", "banking.reconciliation.finalize", "banking.reconciliation.reopen", "banking.bank_originated.review", "banking.bank_originated.approve", "banking.cash.read", "banking.cash.count", "banking.cash.count.approve", "banking.cash.difference.resolve", "banking.transfers.read", "banking.transfers.initiate", "banking.cash_position.read", "banking.cash_forecast.read", "banking.cash_forecast.manage", "banking.reports.read", "banking.audit.read", "banking.export", "banking.settings.manage"],
  "capabilities": { "provides": ["banking.treasury-accounts", "banking.statement-evidence", "banking.reconciliation", "banking.cash-position", "banking.cash-forecast"], "consumes": ["payments.money-movement", "payments.internal-transfers", "payments.payment-accounts", "directory.party", "finbase.money", "finbase.exchange-rate", "ledger.semantic-facts", "subledger.open-items", "pos.cash-settlement", "platform.audit", "platform.files"] },
  "messaging": { "publishes": ["TreasuryAccountActivatedV1", "TreasuryAccountSuspendedV1", "TreasuryAccountClosedV1", "ExternalStatementImportedV1", "ExternalStatementValidatedV1", "ReconciliationMatchCreatedV1", "ReconciliationFinalizedV1", "CashCountFinalizedV1"], "consumes": ["PaymentCompletedV1", "PaymentReversedV1", "PaymentRefundedV1", "InternalTransferCompletedV1", "PosSessionClosedV1"] },
  "lifecycle": { "supportsGoLive": false, "deactivationPolicy": "blocked_if_dependents" }
}

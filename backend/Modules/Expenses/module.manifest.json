{
  "$schema": "../../../docs/platform/module-manifest-schema.json",
  "id": "expenses",
  "version": "1.0.0",
  "contractsVersion": 1,
  "layer": "L4",
  "type": "module",
  "purchasable": false,
  "scope": "tenant",
  "dependencies": { "hard": ["platform-kernel", "hr"], "optionalCapabilities": ["directory.party", "ledger.semantic-facts", "payments.money-movement", "platform.files", "platform.approvals", "finbase.financial-context"] },
  "owns": { "schema": "business_expenses", "entities": ["expense_category", "expense_category_version", "expense", "expense_history", "expense_evidence", "expense_ocr_job", "expense_itemization", "expense_reimbursement_obligation", "expense_participant", "expense_policy_evaluation", "expense_report", "expense_report_item", "expense_report_history", "expense_import_batch", "expense_import_row", "business_advance", "business_advance_application", "expense_card_transaction", "expense_employee_repayment", "mileage_expense_detail", "per_diem_expense_detail", "expense_dimension", "expense_reimbursement_batch", "expense_reimbursement_allocation"] },
  "permissions": ["expenses.read", "expenses.create", "expenses.edit", "expenses.submit", "expenses.approve", "expenses.finalize", "expenses.reverse", "expenses.reimbursement.read", "expenses.reimbursement.manage", "expenses.category.manage", "expenses.audit.read"],

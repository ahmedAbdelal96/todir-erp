  "messaging": { "publishes": ["ExpenseFinalizedV1", "ExpenseReimbursementRequestedV1", "ExpenseMissingReceiptDeclaredV1", "ExpenseApprovalDecidedV1", "ExpenseReimbursementPaidV1", "ExpenseReimbursementFailedV1"], "consumes": ["PaymentCompletedV1", "PaymentFailedV1"] },
  "lifecycle": { "supportsGoLive": true, "deactivationPolicy": "blocked_if_dependents" }
}

{
  "$schema": "../../../docs/platform/module-manifest-schema.json",
  "id": "pricing",
  "version": "1.0.0",
  "contractsVersion": 1,
  "layer": "L1",
  "type": "foundation",
  "purchasable": false,
  "scope": "tenant",
  "dependencies": {
    "hard": ["platform-kernel"],
    "optionalCapabilities": ["catalog.product", "catalog.quantity-conversion", "directory.party", "finbase.money"]
  },
  "owns": {
    "schema": "foundation_pricing",
    "entities": ["price_list", "price_list_version", "price_entry", "price_rule", "price_group", "price_group_member", "price_list_assignment", "pricing_policy", "pricing_import_batch", "pricing_import_row", "pricing_audit"]
  },
  "permissions": ["pricing.read", "pricing.list.manage", "pricing.version.create", "pricing.rule.manage", "pricing.version.activate", "pricing.simulate", "pricing.import", "pricing.export", "pricing.audit.view"],
  "capabilities": {"provides": ["pricing.resolve", "pricing.resolve-batch", "pricing.snapshot"], "consumes": ["catalog.product", "catalog.quantity-conversion", "directory.party", "finbase.money"]},
  "messaging": {"publishes": ["PriceListVersionActivatedV1"], "consumes": ["CatalogProductChangedV1", "CatalogProductUomChangedV1", "CatalogProductArchivedV1"]},
  "lifecycle": {"supportsGoLive": true, "deactivationPolicy": "blocked_if_dependents"}
}

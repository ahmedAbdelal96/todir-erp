{
  "$schema": "../../../docs/platform/module-manifest-schema.json",
  "id": "quality",
  "version": "1.0.0",
  "contractsVersion": 1,
  "layer": "L4",
  "type": "business-module",
  "purchasable": true,
  "scope": "tenant",
  "dependencies": {
    "hard": ["platform-kernel"],
    "optionalCapabilities": ["catalog.product", "directory.party", "inventory.receipt", "inventory.status", "manufacturing.execution", "purchasing.commitments", "service.calibration", "platform.outbox"]
  },
  "owns": {
    "schema": "business_quality",
    "entities": ["quality_plan", "quality_plan_version", "quality_plan_applicability", "quality_trigger_rule", "quality_characteristic", "quality_specification_version", "quality_plan_characteristic", "inspection_method", "sampling_plan", "sampling_plan_version", "quality_action_rule", "inspection", "inspection_plan_snapshot", "quality_sample", "inspection_result", "inspection_result_correction", "inspection_instrument_use", "inspection_review", "inspection_evaluation", "quality_restriction", "quality_restriction_release_operation", "quality_disposition", "quality_disposition_line", "quality_deviation", "quality_concession", "quality_issue", "quality_defect", "nonconformance", "nonconformance_defect", "quality_containment_action", "nonconformance_relation", "capa", "capa_source_link", "capa_root_cause", "capa_action", "capa_effectiveness_check", "supplier_quality_profile", "supplier_corrective_action_request", "supplier_quality_review", "quality_certificate", "quality_certificate_version", "quality_certificate_template", "quality_certificate_result_line", "quality_cost_fact", "quality_state_history", "quality_audit_event", "quality_idempotency", "quality_integration_event"]
  },
  "permissions": [
    "quality.read", "quality.plan.manage", "quality.characteristic.manage", "quality.inspection.create", "quality.inspection.execute", "quality.inspection.review", "quality.hold.manage", "quality.disposition.manage", "quality.issue.manage", "quality.ncr.manage", "quality.capa.manage", "quality.supplier.manage", "quality.certificate.manage", "quality.cost.read", "quality.audit.read", "quality.export"
  ],
  "capabilities": {
    "provides": ["quality.results", "quality.receiving", "quality.restrictions", "quality.certificates", "quality.supplier-quality"],
    "consumes": ["catalog.product", "directory.party", "inventory.receipt", "inventory.status", "manufacturing.execution", "purchasing.commitments", "service.calibration", "platform.outbox"]
  },
  "messaging": {
    "publishes": ["QualityInspectionCompletedV1", "QualityRestrictionCreatedV1", "QualityRestrictionReleasedV1", "QualityDispositionExecutedV1", "QualityNcrCreatedV1", "QualityCapaClosedV1", "QualityCertificateIssuedV1"],
    "consumes": ["PurchaseOrderApprovedV1", "StockReceivedV1", "ProductionOutputReportedV1", "ProductionOperationCompletedV1", "SalesReturnReceivedV1", "CalibrationStatusChangedV1"]
  },
  "lifecycle": { "supportsGoLive": true, "deactivationPolicy": "blocked_if_dependents" }
}

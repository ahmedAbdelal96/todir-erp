{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Planning API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
  "paths": {
    "/api/v1/planning/cycles": { "get": { "responses": { "200": { "description": "Bounded planning cycles" } } }, "post": { "responses": { "201": { "description": "Planning cycle created" } } } },
    "/api/v1/planning/cycles/{id}/open": { "post": { "responses": { "200": { "description": "Cycle opened" } } } },
    "/api/v1/planning/cycles/{id}/submit": { "post": { "responses": { "200": { "description": "Cycle submitted" } } } },
    "/api/v1/planning/cycles/{id}/approve": { "post": { "responses": { "200": { "description": "Cycle approved" } } } },
    "/api/v1/planning/cycles/{id}/publish": { "post": { "responses": { "200": { "description": "Cycle published" } } } },
    "/api/v1/planning/cycles/{id}/close": { "post": { "responses": { "200": { "description": "Cycle closed" } } } },
    "/api/v1/planning/cycles/{id}/archive": { "post": { "responses": { "200": { "description": "Cycle archived" } } } },
    "/api/v1/planning/models": { "post": { "responses": { "201": { "description": "Planning model created" } } } },
    "/api/v1/planning/model-versions": { "post": { "responses": { "201": { "description": "Model version created" } } } },
    "/api/v1/planning/metrics": { "post": { "responses": { "201": { "description": "Typed planning metric; Actual metrics are read-only" }, "400": { "description": "Invalid metric definition" } } } },
    "/api/v1/planning/metric-mappings": { "post": { "responses": { "201": { "description": "Draft versioned owner-to-metric mapping" } } } },
    "/api/v1/planning/metric-mappings/{id}/{action}": { "post": { "responses": { "200": { "description": "Publish or retire a mapping" }, "409": { "description": "Invalid mapping lifecycle transition" } } } },
    "/api/v1/planning/versions": { "get": { "responses": { "200": { "description": "Bounded plan versions" } } }, "post": { "responses": { "201": { "description": "Plan version created" } } } },
    "/api/v1/planning/versions/{id}/compare": { "get": { "responses": { "200": { "description": "Version comparison" } } } },
    "/api/v1/planning/versions/{id}/actual-basis": { "get": { "responses": { "200": { "description": "Pinned or current Actual snapshot basis with mapping and source watermark" } } } },
    "/api/v1/planning/versions/{id}/clone": { "post": { "responses": { "201": { "description": "Draft version clone" } } } },
    "/api/v1/planning/versions/{id}/submit": { "post": { "responses": { "200": { "description": "Version submitted" } } } },
    "/api/v1/planning/versions/{id}/approve": { "post": { "responses": { "200": { "description": "Version approved" } } } },
    "/api/v1/planning/versions/{id}/publish": { "post": { "responses": { "200": { "description": "Version published" } } } },
    "/api/v1/planning/versions/{id}/close": { "post": { "responses": { "200": { "description": "Version closed" } } } },
    "/api/v1/planning/versions/{id}/recalculate": { "post": { "responses": { "202": { "description": "Calculation run started with deterministic formula and trace evaluation" } } } },
    "/api/v1/planning/calculation-runs/{id}/retry": { "post": { "responses": { "202": { "description": "Retry a failed calculation against the current input revision" }, "409": { "description": "Only failed calculation runs can be retried" } } } },
    "/api/v1/planning/forecasts/roll": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RollingForecastRequest" } } } }, "responses": { "201": { "description": "New rolling forecast draft with actual cutoff and preserved prior version" } } } },
    "/api/v1/planning/scenarios": { "post": { "responses": { "201": { "description": "Scenario created" } } } },
    "/api/v1/planning/scenarios/{id}/clone": { "post": { "responses": { "201": { "description": "Scenario cloned" } } } },
    "/api/v1/planning/scenarios/{id}/share": { "post": { "responses": { "200": { "description": "Scenario shared" } } } },
    "/api/v1/planning/scenarios/{id}/adopt-preview": { "post": { "responses": { "201": { "description": "Scenario adopted into a governed draft" } } } },
    "/api/v1/planning/dimensions": { "post": { "responses": { "201": { "description": "Controlled dimension created" } } } },
    "/api/v1/planning/dimensions/{id}/members": { "post": { "responses": { "201": { "description": "Dimension member created" } } } },
    "/api/v1/planning/dimensions/mappings": { "post": { "responses": { "201": { "description": "Versioned mapping created" } } } },
    "/api/v1/planning/formulas": { "post": { "responses": { "201": { "description": "Constrained formula created" } } } },
    "/api/v1/planning/submissions": { "post": { "responses": { "201": { "description": "Submission unit created" } } } },
    "/api/v1/planning/submissions/{id}/coordinates": { "post": { "responses": { "200": { "description": "Attach an exact coordinate scope while the submission is editable" }, "409": { "description": "Submitted coordinates are locked" } } } },
    "/api/v1/planning/submissions/{id}/transition": { "post": { "responses": { "200": { "description": "Submission transition" } } } },
    "/api/v1/planning/grids/query": { "post": { "responses": { "200": { "description": "Bounded planning grid window" } } } },
    "/api/v1/planning/grids/write-batch": { "post": { "responses": { "200": { "description": "Atomic planning input batch" } } } },
    "/api/v1/planning/grids/spread": { "post": { "responses": { "200": { "description": "Legacy batch-compatible grid write" } } } },
    "/api/v1/planning/grids/spread-exact": { "post": { "responses": { "200": { "description": "Exact total-conserving spread" } } } },
    "/api/v1/planning/grids/paste-preview": { "post": { "responses": { "200": { "description": "Validated paste preview" } } } },
    "/api/v1/planning/grid/import/preview": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CsvImportRequest" } } } }, "responses": { "200": { "description": "CSV import validation preview; no rows are committed" } } } },
    "/api/v1/planning/grid/import": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CsvImportRequest" } } } }, "responses": { "200": { "description": "Atomic CSV import into a Draft plan version" }, "409": { "description": "Published or locked coordinates are rejected" } } } },
    "/api/v1/planning/grid/import/xlsx/preview": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/XlsxImportRequest" } } } }, "responses": { "200": { "description": "Safe first-sheet XLSX preview; formulas, macros and external links are rejected" } } } },
    "/api/v1/planning/grid/import/xlsx": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/XlsxImportRequest" } } } }, "responses": { "200": { "description": "Atomic XLSX import into a Draft plan version" }, "409": { "description": "Published or locked coordinates are rejected" } } } },
    "/api/v1/planning/grid/export/xlsx": { "get": { "parameters": [{ "name": "planVersionId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "legalEntityId", "in": "query", "schema": { "type": ["string", "null"], "format": "uuid" } }, { "name": "from", "in": "query", "schema": { "type": ["string", "null"], "format": "date" } }, { "name": "to", "in": "query", "schema": { "type": ["string", "null"], "format": "date" } }, { "name": "template", "in": "query", "schema": { "type": "boolean", "default": false } }], "responses": { "200": { "description": "Authorized bounded XLSX export with formula-safe text and provenance metadata" } } } },
    "/api/v1/planning/grid/template/xlsx": { "get": { "parameters": [{ "name": "planVersionId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Empty planning XLSX template with required metadata" } } } },
    "/api/v1/planning/assumptions": { "get": { "responses": { "200": { "description": "Plan assumptions" } } }, "post": { "responses": { "201": { "description": "Assumption created" } } } },
    "/api/v1/planning/assumptions/{id}/values": { "post": { "responses": { "200": { "description": "Assumption value saved" } } } },
    "/api/v1/planning/budget/baselines": { "post": { "responses": { "201": { "description": "Original budget baseline" } } } },
    "/api/v1/planning/budget/baselines/{id}/{action}": { "post": { "responses": { "200": { "description": "Approve, publish, or close a budget baseline" } } } },
    "/api/v1/planning/budget/baselines/{id}/revisions": { "post": { "responses": { "200": { "description": "Budget revision approved" } } } },
    "/api/v1/planning/budget/baselines/{id}/current": { "get": { "parameters": [{ "name": "asOfDate", "in": "query", "schema": { "type": "string", "format": "date" } }], "responses": { "200": { "description": "Current derived budget: original plus effective approved revisions and transfer net" } } } },
    "/api/v1/planning/targets/{id}/{action}": { "post": { "responses": { "200": { "description": "Approve, publish, or close a governed planning target" } } } },
    "/api/v1/planning/targets/proposals/{id}/{action}": { "post": { "responses": { "200": { "description": "Submit, approve, or reject a planning proposal" } } } },
    "/api/v1/planning/budget/policies": { "post": { "responses": { "201": { "description": "Budget control policy" } } } },
    "/api/v1/planning/budget/buckets": { "post": { "responses": { "201": { "description": "Budget control bucket" } } } },
    "/api/v1/planning/budgets/{id}/transfers": { "post": { "responses": { "201": { "description": "Conserving budget transfer" } } } },
    "/api/v1/planning/budget/check": { "post": { "responses": { "200": { "description": "Budget availability decision" } } } },
    "/api/v1/planning/budget/check-and-reserve": { "post": { "responses": { "200": { "description": "Atomic budget reservation" } } } },
    "/api/v1/planning/budget/overrides": { "post": { "responses": { "201": { "description": "Source-bound budget override approval request" } } } },
    "/api/v1/planning/budget/overrides/{id}": { "get": { "responses": { "200": { "description": "Budget override status" } } } },
    "/api/v1/planning/budget/overrides/{id}/decision": { "post": { "responses": { "200": { "description": "Budget override approval decision" } } } },
    "/api/v1/planning/budget-control/reconcile": { "post": { "responses": { "202": { "description": "Budget control reconciliation or bounded projection rebuild" } } } },
    "/api/v1/planning/budget/buckets/{id}/availability": { "get": { "responses": { "200": { "description": "Current availability" } } } },
    "/api/v1/planning/budget/reservations/{id}/release": { "post": { "responses": { "200": { "description": "Reservation released" } } } },
    "/api/v1/planning/budget/reservations/{id}/adjust": { "post": { "responses": { "200": { "description": "Reservation adjusted" } } } },
    "/api/v1/planning/budget-transfers/{id}/approve": { "post": { "responses": { "200": { "description": "Budget transfer approved" } } } },
    "/api/v1/planning/workforce": { "get": { "responses": { "200": { "description": "Bounded workforce plan" } } }, "post": { "responses": { "201": { "description": "Workforce plan line" } } } },
    "/api/v1/planning/workforce/import-baseline": { "post": { "responses": { "200": { "description": "Validated workforce baseline import" } } } },
    "/api/v1/planning/workforce/cost-impact": { "get": { "responses": { "200": { "description": "Workforce cost impact" } } } },
    "/api/v1/planning/opex": { "get": { "parameters": [{ "name": "planVersionId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "legalEntityId", "in": "query", "schema": { "type": ["string", "null"], "format": "uuid" } }, { "name": "from", "in": "query", "schema": { "type": ["string", "null"], "format": "date" } }, { "name": "to", "in": "query", "schema": { "type": ["string", "null"], "format": "date" } }], "responses": { "200": { "description": "Bounded category and driver-based OPEX plan lines" } } }, "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpexPlanLineRequest" } } } }, "responses": { "201": { "description": "Created or updated OPEX planning line" }, "409": { "description": "Published or locked plan version" } } } },
    "/api/v1/planning/capex": { "get": { "responses": { "200": { "description": "Bounded CapEx plan" } } }, "post": { "responses": { "201": { "description": "CapEx plan item" } } } },
    "/api/v1/planning/capex/{id}/prioritize": { "post": { "responses": { "200": { "description": "CapEx prioritized" } } } },
    "/api/v1/planning/capex/{id}/approve-budget": { "post": { "responses": { "200": { "description": "CapEx budget approved" } } } },
    "/api/v1/planning/revenue": { "post": { "responses": { "200": { "description": "Revenue driver saved" } } } },
    "/api/v1/planning/working-capital": { "post": { "responses": { "200": { "description": "Working capital assumption saved" } } } },
    "/api/v1/planning/fx": { "post": { "responses": { "200": { "description": "Planning FX rate saved" } } } },
    "/api/v1/planning/allocations": { "post": { "responses": { "201": { "description": "Conserving allocation" } } } },
    "/api/v1/planning/targets": { "post": { "description": "Create a governed top-down target in a Draft plan version", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlanningTargetRequest" } } } }, "responses": { "201": { "description": "Planning target created" }, "409": { "description": "Only Draft plan versions may be changed" } } } },
    "/api/v1/planning/targets/proposals": { "post": { "description": "Submit a bottom-up department proposal against a governed target", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePlanningProposalRequest" } } } }, "responses": { "201": { "description": "Planning proposal created" }, "409": { "description": "Proposal is outside the editable plan lifecycle" } } } },
    "/api/v1/planning/targets/proposals/{id}/adjust": { "post": { "description": "Adjust a proposal with an explicit reason", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdjustPlanningProposalRequest" } } } }, "responses": { "200": { "description": "Planning proposal adjusted" }, "409": { "description": "Proposal is outside the editable plan lifecycle" } } } },
    "/api/v1/planning/statements/query": { "post": { "responses": { "200": { "description": "Planning statement projection" } } } },
    "/api/v1/planning/forecast-accuracy": { "post": { "responses": { "200": { "description": "Forecast accuracy and bias" } } } },
    "/api/v1/planning/actuals/refresh": { "post": { "description": "Builds a read-only snapshot from registered owner contracts. Caller-supplied facts are rejected; repeated source watermarks are idempotent.", "responses": { "202": { "description": "Actual snapshot refresh requested" }, "409": { "description": "Unmapped, conflicting, or immutable Actual input" } } } },
    "/api/v1/planning/actuals/refresh-runs/{id}": { "get": { "responses": { "200": { "description": "Actual refresh run" } } } },
    "/api/v1/planning/variance/query": { "post": { "responses": { "200": { "description": "Variance projection" } } } },
    "/api/v1/planning/variance/{coordinateId}/drivers": { "get": { "responses": { "200": { "description": "Variance lineage drivers" } } } },
    "/api/v1/planning/variance/commentary": { "post": { "responses": { "200": { "description": "Variance commentary" } } } },
    "/api/v1/planning/reports/rollup": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RollupRequest" } } } }, "responses": { "200": { "description": "Authorized management rollup converted through explicit Planning FX" }, "409": { "description": "Missing planning FX rate or invalid entity scope" } } } }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "todir_session" },
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "CreatePlanningTargetRequest": { "type": "object", "required": ["planVersionId", "legalEntityId", "periodStart", "metricCode", "targetAmount", "currencyCode"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "legalEntityId": { "type": "string", "format": "uuid" }, "periodStart": { "type": "string", "format": "date" }, "metricCode": { "type": "string" }, "targetAmount": { "type": "number" }, "currencyCode": { "type": "string", "minLength": 3, "maxLength": 3 }, "reason": { "type": ["string", "null"] } } },
      "CreatePlanningProposalRequest": { "type": "object", "required": ["planVersionId", "legalEntityId", "periodStart", "metricCode", "proposedAmount", "currencyCode"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "legalEntityId": { "type": "string", "format": "uuid" }, "departmentRef": { "type": ["string", "null"], "format": "uuid" }, "periodStart": { "type": "string", "format": "date" }, "metricCode": { "type": "string" }, "proposedAmount": { "type": "number" }, "currencyCode": { "type": "string", "minLength": 3, "maxLength": 3 }, "reason": { "type": ["string", "null"] } } },
      "AdjustPlanningProposalRequest": { "type": "object", "required": ["adjustedAmount", "reason"], "properties": { "adjustedAmount": { "type": "number" }, "reason": { "type": "string", "minLength": 1 } } },
      "RollingForecastRequest": { "type": "object", "required": ["sourceVersionId", "actualCutoff"], "properties": { "sourceVersionId": { "type": "string", "format": "uuid" }, "actualCutoff": { "type": "string", "format": "date" }, "name": { "type": ["string", "null"] }, "horizonMonths": { "type": "integer", "minimum": 1, "maximum": 60, "default": 12 } } },
      "CsvImportRequest": { "type": "object", "required": ["planVersionId", "csv"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "csv": { "type": "string", "maxLength": 2000000 }, "commit": { "type": "boolean", "default": false } } },
      "XlsxImportRequest": { "type": "object", "required": ["planVersionId", "spreadsheetContentBase64"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "spreadsheetContentBase64": { "type": "string", "maxLength": 7340032 }, "commit": { "type": "boolean", "default": false } } },
      "XlsxFileView": { "type": "object", "required": ["fileName", "contentType", "spreadsheetContentBase64", "rowCount", "template"], "properties": { "fileName": { "type": "string" }, "contentType": { "type": "string" }, "spreadsheetContentBase64": { "type": "string" }, "rowCount": { "type": "integer", "minimum": 0 }, "template": { "type": "boolean" } } },
      "RollupRequest": { "type": "object", "required": ["planVersionId", "legalEntityIds", "from", "to", "metricCode", "reportingCurrencyCode"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "legalEntityIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "format": "uuid" } }, "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" }, "metricCode": { "type": "string" }, "reportingCurrencyCode": { "type": "string", "minLength": 3, "maxLength": 3 } } }
      ,"OpexPlanLineRequest": { "type": "object", "required": ["planVersionId", "legalEntityId", "categoryCode", "periodStart", "method", "baseAmount", "driverValue", "rate", "growthPercent", "inflationPercent", "currencyCode"], "properties": { "planVersionId": { "type": "string", "format": "uuid" }, "legalEntityId": { "type": "string", "format": "uuid" }, "departmentRef": { "type": ["string", "null"], "format": "uuid" }, "categoryCode": { "type": "string", "maxLength": 80 }, "accountRef": { "type": ["string", "null"] }, "costCenterRef": { "type": ["string", "null"] }, "periodStart": { "type": "string", "format": "date" }, "method": { "type": "string", "enum": ["Fixed", "Variable", "Recurring", "DriverBased"] }, "baseAmount": { "type": "number", "minimum": 0 }, "driverValue": { "type": "number", "minimum": 0 }, "rate": { "type": "number", "minimum": 0 }, "growthPercent": { "type": "number", "minimum": -100 }, "inflationPercent": { "type": "number", "minimum": -100 }, "currencyCode": { "type": "string", "minLength": 3, "maxLength": 3 }, "source": { "type": ["string", "null"] } } }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Platform API", "version": "1.0.0" },
  "paths": {
    "/api/v1/auth/csrf": { "get": { "responses": { "200": { "description": "CSRF request token" } } } },
    "/api/v1/auth/login": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/LoginRequest" },
        "responses": { "200": { "description": "Authenticated, initial password change, or MFA verification required" }, "401": { "description": "Enumeration-safe authentication failure" } }
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/MfaVerificationRequest" },
        "responses": { "200": { "description": "MFA verified or initial password change required" }, "401": { "description": "Invalid or expired challenge" } }
      }
    },
    "/api/v1/auth/password/initial": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/InitialPasswordChangeRequest" },
        "responses": { "200": { "description": "Initial password changed, then MFA or authentication continues" }, "401": { "description": "Invalid or expired challenge" } }
      }
    },
    "/api/v1/auth/password/change": { "post": { "requestBody": { "$ref": "#/components/requestBodies/ChangePasswordRequest" }, "responses": { "204": { "description": "Password changed and sessions invalidated according to policy" }, "400": { "description": "Password change failed" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/auth/logout": { "post": { "responses": { "204": { "description": "Signed out" } } } },
    "/api/v1/auth/mfa/enroll": { "post": { "responses": { "200": { "description": "MFA enrollment secret and one-time recovery codes" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/auth/sessions/revoke": { "post": { "responses": { "204": { "description": "All current identity sessions revoked" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/session": { "get": { "responses": { "200": { "description": "Current secure session" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/session/context": { "get": { "responses": { "200": { "description": "Current server-derived tenant, legal entities, and branches" }, "401": { "description": "Unauthenticated" }, "404": { "description": "Tenant context not found" } } } },
    "/api/v1/context/organization": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/OrganizationSelection" },
        "responses": { "204": { "description": "Organization context selected" }, "400": { "description": "Invalid organization scope" }, "404": { "description": "Organization scope not found" } }
      }
    },
    "/api/v1/tenants/{tenantId}/users": {
      "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "active", "in": "query", "schema": { "type": "boolean" } }, { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Bounded tenant user list" }, "403": { "description": "Identity read permission is required" } } },
      "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateUserRequest" }, "responses": { "201": { "description": "Tenant user created with one-time temporary password" }, "400": { "description": "Invalid user data" }, "403": { "description": "Identity management permission is required" }, "409": { "description": "User or role conflict" } } }
    },
    "/api/v1/tenants/{tenantId}/users/{identityId}": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "identityId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Tenant user" }, "403": { "description": "Identity read permission is required" }, "404": { "description": "User not found in tenant" } } } },
    "/api/v1/tenants/{tenantId}/users/{identityId}/password-reset": { "post": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "identityId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "One-time temporary password returned to authorized administrator" }, "403": { "description": "Identity management permission is required" }, "404": { "description": "Active user not found" } } } },
    "/api/v1/tenants/{tenantId}/users/{identityId}/deactivate": { "post": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "identityId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "204": { "description": "User deactivated and sessions invalidated" }, "403": { "description": "Identity management permission is required" }, "404": { "description": "User not found" } } } },
    "/api/v1/tenants/{tenantId}/users/{identityId}/reactivate": { "post": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "identityId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "204": { "description": "User reactivated" }, "403": { "description": "Identity management permission is required" }, "404": { "description": "User not found" } } } },
    "/api/v1/tenants/{tenantId}/login-domain": {
      "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Tenant login domain" }, "403": { "description": "Tenant read permission is required" } } },
      "put": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/LoginDomainRequest" }, "responses": { "200": { "description": "Tenant login domain changed atomically" }, "400": { "description": "Invalid login domain" }, "403": { "description": "MFA and tenant management permission are required" }, "409": { "description": "Domain conflict" } } }
    },
    "/api/v1/tenants/{tenantId}/organization": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Tenant organization context" }, "403": { "description": "Organization read permission is required" } } } },
    "/api/v1/tenants/{tenantId}/roles": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant roles" }, "403": { "description": "Role management permission is required" } } } },
    "/api/v1/tenants/{tenantId}/modules": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant module instances" }, "403": { "description": "Module view permission is required" } } } },
    "/api/v1/tenants/{tenantId}/settings": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant settings" }, "403": { "description": "Settings read permission is required" } } } },
    "/api/v1/tenants/{tenantId}/audit": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant audit entries" }, "403": { "description": "Audit view permission is required" } } } },
    "/api/v1/tenants/{tenantId}/entitlement": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Current entitlement summary" }, "403": { "description": "Module view permission is required" }, "404": { "description": "Entitlement snapshot not found" } } } },
    "/api/v1/modules": { "get": { "responses": { "200": { "description": "Registered modules" } } } },
    "/api/v1/directory/parties": {
      "get": { "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "partyType", "in": "query", "schema": { "type": "string", "enum": ["Person", "Organization"] } }, { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["Customer", "Supplier"] } }, { "name": "status", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Paged tenant-scoped parties" }, "403": { "description": "Party read permission is required" } } },
      "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateDirectoryPartyRequest" }, "responses": { "201": { "description": "Party created" }, "400": { "description": "Validation failure" }, "409": { "description": "Duplicate or concurrency conflict" } } }
    },
    "/api/v1/directory/parties/{partyId}": {
      "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "responses": { "200": { "description": "Party details" }, "404": { "description": "Party not found" } } },
      "patch": { "requestBody": { "$ref": "#/components/requestBodies/UpdateDirectoryPartyRequest" }, "responses": { "200": { "description": "Party updated" }, "409": { "description": "Concurrency conflict" } } }
    },
    "/api/v1/directory/parties/{partyId}/roles": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddDirectoryRoleRequest" }, "responses": { "200": { "description": "Role enabled" } } } },
    "/api/v1/directory/parties/{partyId}/roles/{role}": { "delete": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "role", "in": "path", "required": true, "schema": { "type": "string", "enum": ["Customer", "Supplier"] } }], "responses": { "200": { "description": "Role disabled" } } } },
    "/api/v1/directory/parties/{partyId}/identifiers": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/DirectoryIdentifierRequest" }, "responses": { "200": { "description": "Identifier added" }, "409": { "description": "Identifier already exists" } } } },
    "/api/v1/directory/parties/{partyId}/contacts": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/DirectoryContactRequest" }, "responses": { "200": { "description": "Contact point added" } } } },
    "/api/v1/directory/parties/{partyId}/addresses": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/DirectoryAddressRequest" }, "responses": { "200": { "description": "Address added" } } } },
    "/api/v1/directory/parties/{partyId}/archive": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/DirectoryVersionRequest" }, "responses": { "200": { "description": "Party archived" } } } },
    "/api/v1/directory/parties/{partyId}/restore": { "post": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/DirectoryVersionRequest" }, "responses": { "200": { "description": "Party restored" } } } },
    "/api/v1/directory/parties/{partyId}/duplicate-candidates": { "get": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Duplicate candidates" } } } },
    "/api/v1/directory/parties/{partyId}/readiness": { "get": { "parameters": [{ "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Party readiness" } } } },
    "/api/v1/catalog/products": {
      "get": { "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "nature", "in": "query", "schema": { "type": "string", "enum": ["Goods", "Service"] } }, { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["Active", "Archived"] } }, { "name": "categoryId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "brandId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Paged tenant-scoped catalog products" }, "403": { "description": "Catalog read permission is required" } } },
      "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogProductRequest" }, "responses": { "201": { "description": "Product created" }, "400": { "description": "Validation failure" }, "409": { "description": "Duplicate or concurrency conflict" } } }
    },
    "/api/v1/catalog/products/{productId}": {
      "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "responses": { "200": { "description": "Product details" }, "404": { "description": "Product not found" } } },
      "patch": { "requestBody": { "$ref": "#/components/requestBodies/UpdateCatalogProductRequest" }, "responses": { "200": { "description": "Product updated" }, "409": { "description": "Concurrency conflict" } } }
    },
    "/api/v1/catalog/products/{productId}/archive": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/CatalogVersionRequest" }, "responses": { "200": { "description": "Product archived" } } } },
    "/api/v1/catalog/products/{productId}/restore": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/CatalogVersionRequest" }, "responses": { "200": { "description": "Product restored" } } } },
    "/api/v1/catalog/products/{productId}/barcodes": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogBarcodeRequest" }, "responses": { "200": { "description": "Barcode added" }, "409": { "description": "Barcode already exists" } } } },
    "/api/v1/catalog/products/{productId}/variants/{variantId}/barcodes": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "variantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogBarcodeRequest" }, "responses": { "200": { "description": "Barcode added to variant" }, "409": { "description": "Barcode already exists" } } } },
    "/api/v1/catalog/products/{productId}/readiness": { "get": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Product readiness" } } } },
    "/api/v1/catalog/products/{productId}/variants": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogVariantRequest" }, "responses": { "201": { "description": "Variant created" }, "409": { "description": "Duplicate SKU" } } } },
    "/api/v1/catalog/products/{productId}/variants/{variantId}/uoms": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "variantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogProductUomRequest" }, "responses": { "201": { "description": "Product unit conversion added" }, "409": { "description": "Overlapping conversion" } } } },
    "/api/v1/catalog/variants/{variantId}/uoms": { "get": { "parameters": [{ "name": "variantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Product units" } } } },
    "/api/v1/catalog/resolve/{value}": { "get": { "parameters": [{ "name": "value", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Resolved SKU or barcode" }, "404": { "description": "Identifier not found" } } } },
    "/api/v1/catalog/products/{productId}/aliases": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogAliasRequest" }, "responses": { "200": { "description": "Alias added" } } } },
    "/api/v1/catalog/products/{productId}/translations": { "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogTranslationRequest" }, "responses": { "200": { "description": "Translation added" } } } },
    "/api/v1/catalog/products/{productId}/references": { "get": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Paged product references" } } }, "post": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AddCatalogReferenceRequest" }, "responses": { "201": { "description": "Product reference added" } } } },
    "/api/v1/catalog/products/{productId}/visibility": { "put": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/CatalogProductVisibilityRequest" }, "responses": { "200": { "description": "Product visibility updated" }, "404": { "description": "Product not found" } } } },
    "/api/v1/catalog/attributes": { "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogAttributeRequest" }, "responses": { "201": { "description": "Attribute created" } } } },
    "/api/v1/catalog/attributes/{attributeId}/values": { "post": { "parameters": [{ "name": "attributeId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogAttributeValueRequest" }, "responses": { "201": { "description": "Attribute value created" }, "404": { "description": "Attribute not found" } } } },
    "/api/v1/catalog/products/{productId}/attributes": { "get": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Product variant attributes" } } } },
    "/api/v1/catalog/products/{productId}/attributes/{attributeId}": { "put": { "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "attributeId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "$ref": "#/components/requestBodies/AssignCatalogAttributeRequest" }, "responses": { "200": { "description": "Attribute assigned to product" }, "404": { "description": "Product or attribute not found" } } } },
    "/api/v1/catalog/imports/preview": { "post": { "requestBody": { "$ref": "#/components/requestBodies/CatalogImportPreviewRequest" }, "responses": { "200": { "description": "Import preview and validation classifications", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogImportSummary" } } } }, "400": { "description": "Invalid import request" } } } },
    "/api/v1/catalog/imports/{batchId}/commit": { "post": { "parameters": [{ "name": "batchId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "202": { "description": "Import queued for worker processing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogImportSummary" } } } }, "409": { "description": "Import state conflict" } } } },
    "/api/v1/catalog/imports/{batchId}": { "get": { "parameters": [{ "name": "batchId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Import reconciliation summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogImportSummary" } } } }, "404": { "description": "Import not found" } } } },
    "/api/v1/catalog/export": { "get": { "responses": { "200": { "description": "Streaming tenant and legal-entity scoped CSV export", "content": { "text/csv": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/api/v1/catalog/categories": { "get": { "responses": { "200": { "description": "Catalog categories" } } }, "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogCategoryRequest" }, "responses": { "201": { "description": "Category created" } } } },
    "/api/v1/catalog/brands": { "get": { "responses": { "200": { "description": "Catalog brands" } } }, "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogBrandRequest" }, "responses": { "201": { "description": "Brand created" } } } },
    "/api/v1/catalog/uoms": { "get": { "responses": { "200": { "description": "Catalog units of measure" } } }, "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateCatalogUomRequest" }, "responses": { "201": { "description": "Unit created" } } } },
    "/api/v1/sample/items": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/CreateSampleItemRequest" },
        "responses": { "201": { "description": "Sample item created" }, "400": { "description": "Invalid item name" }, "403": { "description": "Entitlement or permission denied" } }
      }
    },
    "/api/v1/authorization/check": { "get": { "parameters": [{ "name": "permission", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Permission granted" }, "401": { "description": "Unauthenticated" }, "403": { "description": "Permission denied" } } } },
    "/api/v1/messaging/replay": {

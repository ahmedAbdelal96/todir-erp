{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Platform API", "version": "1.0.0" },
  "paths": {
    "/api/v1/auth/csrf": { "get": { "responses": { "200": { "description": "CSRF request token" } } } },
    "/api/v1/auth/login": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/LoginRequest" },
        "responses": { "200": { "description": "Authenticated or tenant selection required" }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/v1/auth/logout": { "post": { "responses": { "204": { "description": "Signed out" } } } },
    "/api/v1/auth/mfa/enroll": { "post": { "responses": { "200": { "description": "MFA enrollment secret and one-time recovery codes" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/auth/sessions/revoke": { "post": { "responses": { "204": { "description": "All current identity sessions revoked" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/session": { "get": { "responses": { "200": { "description": "Current secure session" }, "401": { "description": "Unauthenticated" } } } },
    "/api/v1/session/context": { "get": { "responses": { "200": { "description": "Current tenant, memberships, legal entities, and branches" }, "401": { "description": "Unauthenticated" }, "404": { "description": "Tenant context not found" } } } },
    "/api/v1/context/tenant": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/TenantSelection" },
        "responses": { "204": { "description": "Tenant context selected" }, "403": { "description": "Membership not authorized" } }
      }
    },
    "/api/v1/context/organization": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/OrganizationSelection" },
        "responses": { "204": { "description": "Organization context selected" }, "400": { "description": "Invalid organization scope" }, "404": { "description": "Organization scope not found" } }
      }
    },
    "/api/v1/tenants/{tenantId}/memberships": {
      "get": {
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }
        ],
        "responses": { "200": { "description": "Tenant memberships" }, "403": { "description": "Membership management permission is required" } }
      }
    },
    "/api/v1/tenants/{tenantId}/memberships/invitations": {
      "post": {
        "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "$ref": "#/components/requestBodies/MembershipInvitationRequest" },
        "responses": { "201": { "description": "Membership invitation created" }, "400": { "description": "Invalid invitation" }, "403": { "description": "Membership management permission is required" } }
      }
    },
    "/api/v1/tenants/{tenantId}/memberships/invitations/accept": {
      "post": {
        "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "$ref": "#/components/requestBodies/MembershipInvitationAcceptanceRequest" },
        "responses": { "204": { "description": "Membership accepted" }, "404": { "description": "Invitation not found or expired" } }
      }
    },
    "/api/v1/tenants/{tenantId}/memberships/{membershipId}/suspend": {
      "post": {
        "parameters": [
          { "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "membershipId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "204": { "description": "Membership suspended" }, "403": { "description": "Membership management permission is required" }, "404": { "description": "Membership not found" } }
      }
    },
    "/api/v1/tenants/{tenantId}/organization": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Tenant organization context" }, "403": { "description": "Organization read permission is required" } } } },
    "/api/v1/tenants/{tenantId}/roles": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant roles" }, "403": { "description": "Role management permission is required" } } } },
    "/api/v1/tenants/{tenantId}/modules": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant module instances" }, "403": { "description": "Module view permission is required" } } } },
    "/api/v1/tenants/{tenantId}/settings": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant settings" }, "403": { "description": "Settings read permission is required" } } } },
    "/api/v1/tenants/{tenantId}/audit": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } }], "responses": { "200": { "description": "Tenant audit entries" }, "403": { "description": "Audit view permission is required" } } } },
    "/api/v1/tenants/{tenantId}/entitlement": { "get": { "parameters": [{ "name": "tenantId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Current entitlement summary" }, "403": { "description": "Module view permission is required" }, "404": { "description": "Entitlement snapshot not found" } } } },
    "/api/v1/modules": { "get": { "responses": { "200": { "description": "Registered modules" } } } },
    "/api/v1/sample/items": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/CreateSampleItemRequest" },
        "responses": { "201": { "description": "Sample item created" }, "400": { "description": "Invalid item name" }, "403": { "description": "Entitlement or permission denied" } }
      }
    },
    "/api/v1/authorization/check": { "get": { "parameters": [{ "name": "permission", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Permission granted" }, "401": { "description": "Unauthenticated" }, "403": { "description": "Permission denied" } } } },
    "/api/v1/messaging/replay": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/MessageReplayRequest" },
        "responses": { "204": { "description": "Message republished and error resolved" }, "403": { "description": "MFA or permission is required" }, "404": { "description": "Message not found" }, "409": { "description": "No unresolved error is available" } }
      }
    }
  },
  "components": {
    "requestBodies": {
      "LoginRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
      "TenantSelection": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantSelection" } } } },
      "OrganizationSelection": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationSelection" } } } },
      "MessageReplayRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageReplayRequest" } } } },
      "CreateSampleItemRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSampleItemRequest" } } } },
      "MembershipInvitationRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipInvitationRequest" } } } },
      "MembershipInvitationAcceptanceRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipInvitationAcceptanceRequest" } } } }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password", "tenantId"],
        "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" }, "tenantId": { "type": "string", "format": "uuid" }, "mfaCode": { "type": ["string", "null"] } },
        "additionalProperties": false
      },
      "TenantSelection": {
        "type": "object",
        "required": ["tenantId"],
        "properties": { "tenantId": { "type": "string", "format": "uuid" } },
        "additionalProperties": false
      },
      "OrganizationSelection": {
        "type": "object",
        "properties": { "legalEntityId": { "type": ["string", "null"], "format": "uuid" }, "branchId": { "type": ["string", "null"], "format": "uuid" } },
        "additionalProperties": false
      },
      "MessageReplayRequest": {
        "type": "object",
        "required": ["messageId", "tenantId", "consumerEndpoint", "reason"],
        "properties": { "messageId": { "type": "string", "format": "uuid" }, "tenantId": { "type": "string", "format": "uuid" }, "consumerEndpoint": { "type": "string", "minLength": 1, "maxLength": 200 }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "additionalProperties": false
      },
      "CreateSampleItemRequest": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "additionalProperties": false
      },
      "MembershipInvitationRequest": {
        "type": "object",
        "required": ["identityId", "displayName", "expiresAt"],
        "properties": { "identityId": { "type": "string", "format": "uuid" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 200 }, "expiresAt": { "type": "string", "format": "date-time" } },
        "additionalProperties": false
      },
      "MembershipInvitationAcceptanceRequest": {
        "type": "object",
        "required": ["token"],
        "properties": { "token": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "additionalProperties": false
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Sales API", "version": "1.0.0", "description": "Typed Sales quotation, order, fulfillment and return contract." },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "Sales" }],
  "paths": {
    "/api/v1/sales/legal-entities/{entityId}/quotations": { "get": { "$ref": "#/components/operations/listQuotations" }, "post": { "$ref": "#/components/operations/createQuotation" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}": { "get": { "$ref": "#/components/operations/get" }, "put": { "$ref": "#/components/operations/updateQuotation" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/open": { "post": { "$ref": "#/components/operations/quotationCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/accept": { "post": { "$ref": "#/components/operations/acceptQuotation" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/decline": { "post": { "$ref": "#/components/operations/quotationCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/cancel": { "post": { "$ref": "#/components/operations/quotationCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/revise": { "post": { "$ref": "#/components/operations/updateQuotation" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/convert-to-invoice": { "post": { "$ref": "#/components/operations/convertQuotation" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/accept-and-invoice": { "post": { "$ref": "#/components/operations/acceptAndInvoice" } },
    "/api/v1/sales/legal-entities/{entityId}/quotations/{id}/convert-to-order": { "post": { "$ref": "#/components/operations/convertQuotationToOrder" } },
    "/api/v1/sales/legal-entities/{entityId}/orders": { "get": { "$ref": "#/components/operations/listOrders" }, "post": { "$ref": "#/components/operations/createOrder" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}": { "get": { "$ref": "#/components/operations/get" }, "put": { "$ref": "#/components/operations/updateOrder" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}/confirm": { "post": { "$ref": "#/components/operations/orderCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}/release-reservation": { "post": { "$ref": "#/components/operations/orderCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}/cancel-remaining": { "post": { "$ref": "#/components/operations/orderCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}/fulfill": { "post": { "$ref": "#/components/operations/fulfillOrder" } },
    "/api/v1/sales/legal-entities/{entityId}/orders/{id}/create-invoice": { "post": { "$ref": "#/components/operations/orderCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/returns": { "post": { "$ref": "#/components/operations/createReturn" } },
    "/api/v1/sales/legal-entities/{entityId}/returns/{id}": { "get": { "$ref": "#/components/operations/get" } },
    "/api/v1/sales/legal-entities/{entityId}/returns/{id}/approve": { "post": { "$ref": "#/components/operations/returnCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/returns/{id}/execute": { "post": { "$ref": "#/components/operations/returnCommand" } },
    "/api/v1/sales/legal-entities/{entityId}/customer-profiles/{partyId}": { "put": { "$ref": "#/components/operations/updateCustomerProfile" } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "operations": {
      "listQuotations": { "operationId": "salesListQuotations", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Bounded tenant-scoped quotation page." } } },
      "listOrders": { "operationId": "salesListOrders", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Bounded tenant-scoped order page." } } },
      "get": { "operationId": "salesGet", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Tenant-scoped resource." }, "404": { "description": "Not found." } } },
      "createQuotation": { "operationId": "salesCreateQuotation", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreateQuotation" }, "responses": { "201": { "description": "Created." } } },
      "updateQuotation": { "operationId": "salesUpdateQuotation", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/UpdateQuotation" }, "responses": { "200": { "description": "Updated." }, "409": { "description": "Conflict." } } },
      "createOrder": { "operationId": "salesCreateOrder", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreateOrder" }, "responses": { "201": { "description": "Created." } } },
      "updateOrder": { "operationId": "salesUpdateOrder", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/UpdateOrder" }, "responses": { "200": { "description": "Updated." }, "409": { "description": "Conflict." } } },
      "acceptQuotation": { "operationId": "salesAcceptQuotation", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AcceptQuotation" }, "responses": { "200": { "description": "Accepted." } } },
      "acceptAndInvoice": { "operationId": "salesAcceptAndInvoice", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/AcceptAndInvoice" }, "responses": { "200": { "description": "Accepted and invoiced." }, "409": { "description": "Conflict." } } },
      "convertQuotation": { "operationId": "salesConvertQuotation", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConvertQuotation" }, "responses": { "200": { "description": "Converted." }, "409": { "description": "Conflict." } } },
      "convertQuotationToOrder": { "operationId": "salesConvertQuotationToOrder", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConvertQuotationToOrder" }, "responses": { "201": { "description": "Order created." }, "409": { "description": "Conflict." } } },
      "quotationCommand": { "operationId": "salesQuotationCommand", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/QuotationCommand" }, "responses": { "200": { "description": "Command result." }, "409": { "description": "Conflict." } } },
      "orderCommand": { "operationId": "salesOrderCommand", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/OrderCommand" }, "responses": { "200": { "description": "Command result." }, "409": { "description": "Conflict." } } },
      "fulfillOrder": { "operationId": "salesFulfillOrder", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/FulfillOrder" }, "responses": { "200": { "description": "Fulfillment result." }, "409": { "description": "Conflict." } } },
      "createReturn": { "operationId": "salesCreateReturn", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreateReturn" }, "responses": { "201": { "description": "Return requested." } } },
      "returnCommand": { "operationId": "salesReturnCommand", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ReturnCommand" }, "responses": { "200": { "description": "Return command result." } } },
      "updateCustomerProfile": { "operationId": "salesUpdateCustomerProfile", "tags": ["Sales"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CustomerProfile" }, "responses": { "200": { "description": "Updated." } } }
    },
    "requestBodies": {
      "CreateQuotation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateQuotationRequest" } } } },
      "UpdateQuotation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateQuotationRequest" } } } },
      "CreateOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
      "UpdateOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateOrderRequest" } } } },
      "AcceptQuotation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AcceptQuotationRequest" } } } },
      "AcceptAndInvoice": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AcceptAndInvoiceQuotationRequest" } } } },
      "ConvertQuotation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConvertQuotationRequest" } } } },
      "ConvertQuotationToOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConvertQuotationToOrderRequest" } } } },
      "QuotationCommand": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuotationCommandRequest" } } } },
      "OrderCommand": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderCommandRequest" } } } },
      "FulfillOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FulfillOrderRequest" } } } },
      "CreateReturn": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReturnRequest" } } } },
      "ReturnCommand": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReturnCommandRequest" } } } },
      "CustomerProfile": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesCustomerProfileRequest" } } } }
    },
    "schemas": {
      "Line": { "type": "object", "required": ["description", "quantity"], "properties": { "productVariantId": { "type": ["string", "null"], "format": "uuid" }, "unitOfMeasureId": { "type": ["string", "null"], "format": "uuid" }, "description": { "type": "string", "maxLength": 1000 }, "quantity": { "type": "number", "exclusiveMinimum": 0 }, "unitPrice": { "type": ["number", "null"], "minimum": 0 }, "discountAmount": { "type": "number", "minimum": 0 }, "uomCode": { "type": ["string", "null"] } } },
      "CreateQuotationRequest": { "type": "object", "required": ["legalEntityId", "partyId", "currencyCode", "quoteDate", "lines"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "branchId": { "type": ["string", "null"], "format": "uuid" }, "partyId": { "type": "string", "format": "uuid" }, "currencyCode": { "type": "string", "minLength": 3, "maxLength": 3 }, "quoteDate": { "type": "string", "format": "date" }, "validUntil": { "type": ["string", "null"], "format": "date" }, "lines": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/components/schemas/Line" } } } },
      "UpdateQuotationRequest": { "allOf": [{ "$ref": "#/components/schemas/CreateQuotationRequest" }, { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 } } }] },
      "CreateOrderRequest": { "allOf": [{ "$ref": "#/components/schemas/CreateQuotationRequest" }, { "type": "object", "required": ["orderDate"], "properties": { "orderDate": { "type": "string", "format": "date" }, "quotationId": { "type": ["string", "null"], "format": "uuid" }, "warehouseId": { "type": ["string", "null"], "format": "uuid" } } }] },
      "UpdateOrderRequest": { "type": "object", "required": ["version", "lines"], "properties": { "version": { "type": "integer", "format": "int64" }, "lines": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/components/schemas/Line" } }, "customerReference": { "type": ["string", "null"] }, "requestedDeliveryDate": { "type": ["string", "null"], "format": "date" } } },
      "AcceptQuotationRequest": { "type": "object", "required": ["revisionNumber", "acceptanceMethod", "idempotencyKey"], "properties": { "revisionNumber": { "type": "integer", "minimum": 1 }, "acceptanceMethod": { "type": "string", "maxLength": 32 }, "evidenceReference": { "type": ["string", "null"] }, "note": { "type": ["string", "null"] }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 } } },
      "AcceptAndInvoiceQuotationRequest": { "type": "object", "required": ["revisionNumber", "acceptanceMethod", "acceptanceIdempotencyKey", "invoiceIdempotencyKey"], "properties": { "revisionNumber": { "type": "integer", "minimum": 1 }, "acceptanceMethod": { "type": "string" }, "evidenceReference": { "type": ["string", "null"] }, "note": { "type": ["string", "null"] }, "acceptanceIdempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "invoiceIdempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "deliverNow": { "type": "boolean" }, "warehouseId": { "type": ["string", "null"], "format": "uuid" } } },
      "ConvertQuotationRequest": { "type": "object", "required": ["acceptedRevision", "idempotencyKey"], "properties": { "acceptedRevision": { "type": "integer", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "conversionMode": { "type": "string" }, "deliverNow": { "type": "boolean" }, "warehouseId": { "type": ["string", "null"], "format": "uuid" } } },
      "ConvertQuotationToOrderRequest": { "type": "object", "required": ["acceptedRevision", "idempotencyKey"], "properties": { "acceptedRevision": { "type": "integer", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "warehouseId": { "type": ["string", "null"], "format": "uuid" } } },
      "QuotationCommandRequest": { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer", "format": "int64" }, "reason": { "type": ["string", "null"] } } },
      "OrderCommandRequest": { "type": "object", "required": ["version", "idempotencyKey"], "properties": { "version": { "type": "integer", "format": "int64" }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "reason": { "type": ["string", "null"] }, "warehouseId": { "type": ["string", "null"], "format": "uuid" }, "creditOverrideReason": { "type": ["string", "null"] } } },
      "FulfillOrderRequest": { "type": "object", "required": ["version", "idempotencyKey", "lines"], "properties": { "version": { "type": "integer", "format": "int64" }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "lines": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["orderLineId", "quantity"], "properties": { "orderLineId": { "type": "string", "format": "uuid" }, "quantity": { "type": "number", "exclusiveMinimum": 0 } } } } } },
      "CreateReturnRequest": { "type": "object", "required": ["legalEntityId", "partyId", "sourceDocumentType", "lines", "reason"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "partyId": { "type": "string", "format": "uuid" }, "sourceDocumentType": { "type": "string" }, "sourceDocumentId": { "type": ["string", "null"], "format": "uuid" }, "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Line" } }, "reason": { "type": "string", "maxLength": 1000 } } },
      "ReturnCommandRequest": { "type": "object", "required": ["version", "idempotencyKey"], "properties": { "version": { "type": "integer", "format": "int64" }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 } } },
      "SalesCustomerProfileRequest": { "type": "object", "required": ["legalEntityId", "partyId"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "partyId": { "type": "string", "format": "uuid" }, "defaultWarehouseId": { "type": ["string", "null"], "format": "uuid" }, "defaultQuoteValidityDays": { "type": ["integer", "null"], "minimum": 1 }, "customerPoRequired": { "type": "boolean" } } }
    }
  }
}

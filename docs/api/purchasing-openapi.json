{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Purchasing API", "version": "1.0.0", "description": "Typed tenant-scoped purchase order, approval and supplier-invoice source contract." },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "Purchasing" }],
  "paths": {
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders": {
      "get": { "$ref": "#/components/operations/listPurchaseOrders" },
      "post": { "$ref": "#/components/operations/createPurchaseOrder" }
    },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}": {
      "get": { "$ref": "#/components/operations/getPurchaseOrder" },
      "put": { "$ref": "#/components/operations/updatePurchaseOrder" }
    },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions": { "post": { "$ref": "#/components/operations/createPurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions/{id}": { "get": { "$ref": "#/components/operations/getPurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions/{id}/submit": { "post": { "$ref": "#/components/operations/submitPurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions/{id}/approve": { "post": { "$ref": "#/components/operations/approvePurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions/{id}/reject": { "post": { "$ref": "#/components/operations/rejectPurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-requisitions/{id}/convert": { "post": { "$ref": "#/components/operations/convertPurchaseRequisition" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/amend": { "post": { "$ref": "#/components/operations/amendPurchaseOrder" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/approve": { "post": { "$ref": "#/components/operations/approvePurchaseOrder" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/reject": { "post": { "$ref": "#/components/operations/rejectPurchaseOrder" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/cancel-remaining": { "post": { "$ref": "#/components/operations/cancelPurchaseOrder" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/close": { "post": { "$ref": "#/components/operations/closePurchaseOrder" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/create-supplier-invoice": { "post": { "$ref": "#/components/operations/createSupplierInvoice" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/close-short": { "post": { "$ref": "#/components/operations/closeShort" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/receive": { "post": { "$ref": "#/components/operations/receive" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/approve-and-bill": { "post": { "$ref": "#/components/operations/approveAndBill" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/receive-and-bill": { "post": { "$ref": "#/components/operations/receiveAndBill" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/match": { "post": { "$ref": "#/components/operations/match" } },
    "/api/v1/purchasing/legal-entities/{entityId}/suppliers/{supplierId}/profile": { "get": { "$ref": "#/components/operations/getProfile" }, "put": { "$ref": "#/components/operations/saveProfile" } },
    "/api/v1/purchasing/legal-entities/{entityId}/settings": { "get": { "$ref": "#/components/operations/getSettings" }, "put": { "$ref": "#/components/operations/saveSettings" } },
    "/api/v1/purchasing/legal-entities/{entityId}/purchase-orders/{id}/returns": { "post": { "$ref": "#/components/operations/createReturn" } },
    "/api/v1/purchasing/legal-entities/{entityId}/returns/{id}": { "get": { "$ref": "#/components/operations/getReturn" } },
    "/api/v1/purchasing/legal-entities/{entityId}/returns/{id}/approve": { "post": { "$ref": "#/components/operations/approveReturn" } },
    "/api/v1/purchasing/legal-entities/{entityId}/returns/{id}/execute": { "post": { "$ref": "#/components/operations/executeReturn" } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "operations": {
      "listPurchaseOrders": { "operationId": "purchasingListPurchaseOrders", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Bounded tenant-scoped purchase order page." } } },
      "getPurchaseOrder": { "operationId": "purchasingGetPurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Purchase order detail." }, "404": { "description": "Not found." } } },
      "createPurchaseRequisition": { "operationId": "purchasingCreatePurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreatePurchaseRequisition" }, "responses": { "201": { "description": "Purchase requisition created." } } },
      "getPurchaseRequisition": { "operationId": "purchasingGetPurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Purchase requisition detail." }, "404": { "description": "Not found." } } },
      "submitPurchaseRequisition": { "operationId": "purchasingSubmitPurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RequisitionCommand" }, "responses": { "200": { "description": "Submitted for approval." } } },
      "approvePurchaseRequisition": { "operationId": "purchasingApprovePurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RequisitionCommand" }, "responses": { "200": { "description": "Approved." } } },
      "rejectPurchaseRequisition": { "operationId": "purchasingRejectPurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RequisitionCommand" }, "responses": { "200": { "description": "Rejected." } } },
      "convertPurchaseRequisition": { "operationId": "purchasingConvertPurchaseRequisition", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConvertRequisition" }, "responses": { "201": { "description": "Purchase order created from the approved requisition." } } },
      "createPurchaseOrder": { "operationId": "purchasingCreatePurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreatePurchaseOrder" }, "responses": { "201": { "description": "Created." }, "422": { "description": "Business validation failed." } } },
      "updatePurchaseOrder": { "operationId": "purchasingUpdatePurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/UpdatePurchaseOrder" }, "responses": { "200": { "description": "Updated." }, "409": { "description": "Optimistic concurrency conflict." } } },
      "amendPurchaseOrder": { "operationId": "purchasingAmendPurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/UpdatePurchaseOrder" }, "responses": { "200": { "description": "Amendment recorded and sent for approval." }, "409": { "description": "Conflict." } } },
      "approvePurchaseOrder": { "operationId": "purchasingApprovePurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Approved." }, "409": { "description": "Conflict." } } },
      "rejectPurchaseOrder": { "operationId": "purchasingRejectPurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Rejected." } } },
      "cancelPurchaseOrder": { "operationId": "purchasingCancelPurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Cancelled." } } },
      "closePurchaseOrder": { "operationId": "purchasingClosePurchaseOrder", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Closed." } } },
      "createSupplierInvoice": { "operationId": "purchasingCreateSupplierInvoice", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/CreateSupplierInvoice" }, "responses": { "201": { "description": "Supplier invoice draft created through Invoicing." }, "409": { "description": "Idempotency or conversion conflict." } } },
      "closeShort": { "operationId": "purchasingCloseShort", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Remaining quantity closed short." } } },
      "receive": { "operationId": "purchasingReceive", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Receive" }, "responses": { "201": { "description": "Inventory receipt linked." } } },
      "approveAndBill": { "operationId": "purchasingApproveAndBill", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ApproveAndBill" }, "responses": { "201": { "description": "Approved and supplier invoice created." } } },
      "receiveAndBill": { "operationId": "purchasingReceiveAndBill", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/ReceiveAndBill" }, "responses": { "201": { "description": "Receipt and supplier invoice created." } } },
      "match": { "operationId": "purchasingMatch", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Match" }, "responses": { "200": { "description": "Persisted match result." } } },
      "getProfile": { "operationId": "purchasingGetSupplierProfile", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Supplier purchasing profile." } } },
      "saveProfile": { "operationId": "purchasingSaveSupplierProfile", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Profile" }, "responses": { "200": { "description": "Supplier purchasing profile saved." } } },
      "getSettings": { "operationId": "purchasingGetSettings", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Purchasing settings." } } },
      "saveSettings": { "operationId": "purchasingSaveSettings", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Settings" }, "responses": { "200": { "description": "Purchasing settings saved." } } },
      "createReturn": { "operationId": "purchasingCreateReturn", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Return" }, "responses": { "201": { "description": "Supplier return intent created." } } },
      "getReturn": { "operationId": "purchasingGetReturn", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Supplier return intent." } } },
      "approveReturn": { "operationId": "purchasingApproveReturn", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Command" }, "responses": { "200": { "description": "Supplier return approved." } } },
      "executeReturn": { "operationId": "purchasingExecuteReturn", "tags": ["Purchasing"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Supplier return executed through owning modules." } } }
    },
    "requestBodies": {
      "CreatePurchaseOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePurchaseOrderRequest" } } } },
      "CreatePurchaseRequisition": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePurchaseRequisitionRequest" } } } },
      "RequisitionCommand": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurchaseRequisitionCommandRequest" } } } },
      "ConvertRequisition": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConvertPurchaseRequisitionRequest" } } } },
      "UpdatePurchaseOrder": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePurchaseOrderRequest" } } } },
      "Command": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurchaseOrderCommandRequest" } } } },
      "CreateSupplierInvoice": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSupplierInvoiceRequest" } } } },
      "Receive": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReceivePurchaseOrderRequest" } } } },
      "ApproveAndBill": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApproveAndBillRequest" } } } },
      "ReceiveAndBill": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReceiveAndBillRequest" } } } },
      "Match": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatchPurchaseOrderRequest" } } } },
      "Profile": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SupplierPurchaseProfileRequest" } } } },
      "Settings": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurchaseSettingsRequest" } } } },
      "Return": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSupplierReturnRequest" } } } }
    },
    "schemas": {
      "CreatePurchaseRequisitionRequest": { "type": "object", "required": ["legalEntityId", "supplierPartyId", "currencyCode", "requestedDate", "lines"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "supplierPartyId": { "type": "string", "format": "uuid" }, "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" }, "requestedDate": { "type": "string", "format": "date" }, "lines": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/components/schemas/PurchaseRequisitionLineRequest" } } } },
      "PurchaseRequisitionLineRequest": { "type": "object", "required": ["description", "quantity", "unitPrice"], "properties": { "productVariantId": { "type": ["string", "null"], "format": "uuid" }, "unitOfMeasureId": { "type": ["string", "null"], "format": "uuid" }, "unitCode": { "type": ["string", "null"] }, "description": { "type": "string", "minLength": 1, "maxLength": 1000 }, "quantity": { "type": "number", "exclusiveMinimum": 0 }, "unitPrice": { "type": "number", "minimum": 0 } } },
      "PurchaseRequisitionCommandRequest": { "type": "object", "required": ["version", "idempotencyKey"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "reason": { "type": ["string", "null"], "maxLength": 500 } } },
      "ConvertPurchaseRequisitionRequest": { "type": "object", "required": ["version", "idempotencyKey", "orderDate", "lines"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "branchId": { "type": ["string", "null"], "format": "uuid" }, "orderDate": { "type": "string", "format": "date" }, "lines": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["requisitionLineId", "quantity"], "properties": { "requisitionLineId": { "type": "string", "format": "uuid" }, "quantity": { "type": "number", "exclusiveMinimum": 0 } } } } } },
      "PurchaseOrderLineRequest": { "type": "object", "required": ["description", "quantity"], "properties": { "productVariantId": { "type": ["string", "null"], "format": "uuid" }, "productTemplateId": { "type": ["string", "null"], "format": "uuid" }, "unitOfMeasureId": { "type": ["string", "null"], "format": "uuid" }, "unitCode": { "type": ["string", "null"] }, "description": { "type": "string", "minLength": 1, "maxLength": 1000 }, "quantity": { "type": "number", "exclusiveMinimum": 0 }, "unitPrice": { "type": ["number", "null"], "minimum": 0 }, "priceOverrideReason": { "type": ["string", "null"], "maxLength": 500 } } },
      "CreatePurchaseOrderRequest": { "type": "object", "required": ["legalEntityId", "supplierPartyId", "currencyCode", "orderDate", "lines"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "branchId": { "type": ["string", "null"], "format": "uuid" }, "supplierPartyId": { "type": "string", "format": "uuid" }, "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" }, "orderDate": { "type": "string", "format": "date" }, "priceListId": { "type": ["string", "null"], "format": "uuid" }, "approvalRequired": { "type": ["boolean", "null"] }, "lines": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/components/schemas/PurchaseOrderLineRequest" } } } },
      "UpdatePurchaseOrderRequest": { "type": "object", "required": ["version", "supplierPartyId", "currencyCode", "orderDate", "lines"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 }, "supplierPartyId": { "type": "string", "format": "uuid" }, "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" }, "orderDate": { "type": "string", "format": "date" }, "lines": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/components/schemas/PurchaseOrderLineRequest" } } } },
      "PurchaseOrderCommandRequest": { "type": "object", "required": ["version", "idempotencyKey"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "reason": { "type": ["string", "null"], "maxLength": 1000 } } },
      "CreateSupplierInvoiceRequest": { "type": "object", "required": ["version", "idempotencyKey", "documentDate", "postingDate", "taxDate"], "properties": { "version": { "type": "integer", "format": "int64", "minimum": 1 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "documentDate": { "type": "string", "format": "date" }, "postingDate": { "type": "string", "format": "date" }, "taxDate": { "type": "string", "format": "date" }, "supplierInvoiceNumber": { "type": ["string", "null"], "maxLength": 160 }, "lines": { "type": ["array", "null"], "items": { "$ref": "#/components/schemas/PurchaseInvoiceLineRequest" } } } },
      "PurchaseInvoiceLineRequest": { "type": "object", "required": ["purchaseOrderLineId", "quantity"], "properties": { "purchaseOrderLineId": { "type": "string", "format": "uuid" }, "quantity": { "type": "number", "exclusiveMinimum": 0 } } },
      "ReceivePurchaseOrderRequest": { "type": "object", "required": ["legalEntityId", "version", "idempotencyKey", "operationalDate", "postingDate", "lines"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "version": { "type": "integer", "format": "int64" }, "idempotencyKey": { "type": "string" }, "operationalDate": { "type": "string", "format": "date" }, "postingDate": { "type": "string", "format": "date" }, "lines": { "type": "array", "minItems": 1, "items": { "type": "object" } } } },
      "MatchPurchaseOrderRequest": { "type": "object", "required": ["version", "supplierInvoiceId", "basis", "idempotencyKey"], "properties": { "version": { "type": "integer", "format": "int64" }, "supplierInvoiceId": { "type": "string", "format": "uuid" }, "basis": { "type": "string", "enum": ["TwoWay", "ThreeWay", "Disabled"] }, "quantityTolerance": { "type": "number" }, "priceAbsoluteTolerance": { "type": "number" }, "pricePercentageTolerance": { "type": "number" }, "taxTolerance": { "type": "number" }, "idempotencyKey": { "type": "string" }, "approveException": { "type": "boolean" }, "reason": { "type": ["string", "null"] } } },
      "SupplierPurchaseProfileRequest": { "type": "object", "required": ["legalEntityId", "supplierPartyId", "supplierReferenceRequired"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "supplierPartyId": { "type": "string", "format": "uuid" }, "supplierCode": { "type": ["string", "null"] }, "paymentTermId": { "type": ["string", "null"], "format": "uuid" }, "defaultCurrencyCode": { "type": ["string", "null"] }, "defaultPriceListId": { "type": ["string", "null"], "format": "uuid" }, "defaultBuyerId": { "type": ["string", "null"], "format": "uuid" }, "defaultWarehouseId": { "type": ["string", "null"], "format": "uuid" }, "leadTimeDays": { "type": ["integer", "null"], "minimum": 0 }, "supplierReferenceRequired": { "type": "boolean" }, "purchasePriceContextJson": { "type": ["string", "null"] } } },
      "PurchaseSettingsRequest": { "type": "object", "required": ["legalEntityId", "approvalRequired", "overReceiptPolicy", "overReceiptTolerance", "invoiceWithoutReceipt", "threeWayMatching", "buyerApproverSeparation", "quantityTolerance", "priceAbsoluteTolerance", "pricePercentageTolerance", "taxTolerance", "invoiceEligibilityBasis"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "approvalRequired": { "type": "boolean" }, "approvalThreshold": { "type": ["number", "null"] }, "overReceiptPolicy": { "type": "string" }, "overReceiptTolerance": { "type": "number", "minimum": 0 }, "invoiceWithoutReceipt": { "type": "boolean" }, "threeWayMatching": { "type": "boolean" }, "buyerApproverSeparation": { "type": "boolean" }, "quantityTolerance": { "type": "number", "minimum": 0 }, "priceAbsoluteTolerance": { "type": "number", "minimum": 0 }, "pricePercentageTolerance": { "type": "number", "minimum": 0 }, "taxTolerance": { "type": "number", "minimum": 0 }, "invoiceEligibilityBasis": { "type": "string" } } },
      "PurchaseReceiptLineRequest": { "type": "object", "required": ["purchaseOrderLineId", "productVariantId", "warehouseId", "unitOfMeasureId", "quantity"], "properties": { "purchaseOrderLineId": { "type": "string", "format": "uuid" }, "productVariantId": { "type": "string", "format": "uuid" }, "warehouseId": { "type": "string", "format": "uuid" }, "locationId": { "type": ["string", "null"], "format": "uuid" }, "unitOfMeasureId": { "type": "string", "format": "uuid" }, "quantity": { "type": "number", "exclusiveMinimum": 0 }, "lotId": { "type": ["string", "null"], "format": "uuid" }, "serialId": { "type": ["string", "null"], "format": "uuid" } } },
      "ApproveAndBillRequest": { "type": "object", "required": ["approval", "invoice"], "properties": { "approval": { "$ref": "#/components/schemas/PurchaseOrderCommandRequest" }, "invoice": { "$ref": "#/components/schemas/CreateSupplierInvoiceRequest" } } },
      "ReceiveAndBillRequest": { "type": "object", "required": ["receipt", "invoice"], "properties": { "receipt": { "$ref": "#/components/schemas/ReceivePurchaseOrderRequest" }, "invoice": { "$ref": "#/components/schemas/CreateSupplierInvoiceRequest" } } },
      "CreateSupplierReturnRequest": { "type": "object", "required": ["version", "resolution", "reason", "lines"], "properties": { "version": { "type": "integer", "format": "int64" }, "resolution": { "type": "string", "enum": ["PhysicalReturn", "SupplierCredit", "ServiceCredit"] }, "reason": { "type": "string" }, "originalInvoiceId": { "type": ["string", "null"], "format": "uuid" }, "lines": { "type": "array", "minItems": 1, "items": { "type": "object" } } } }
    }
  }
}

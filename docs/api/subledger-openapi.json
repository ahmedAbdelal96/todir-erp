{
  "openapi": "3.1.0",
  "info": { "title": "TODIR Subledger API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/subledger/open-items": { "get": { "operationId": "listOpenItems", "summary": "List a party's open items with bounded filters and cursor pagination", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyId" }, { "name": "direction", "in": "query", "schema": { "type": "string", "enum": ["Receivable", "Payable"] } }, { "name": "openOnly", "in": "query", "schema": { "type": "boolean", "default": true } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } }, { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 120 } }, { "name": "dueFrom", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "dueTo", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "currencyCode", "in": "query", "schema": { "type": "string", "pattern": "^[A-Z]{3}$" } }, { "name": "overdueOnly", "in": "query", "schema": { "type": "boolean", "default": false } }, { "name": "asOfDate", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "status", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Bounded open-item page" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/parties/{partyId}/open-items": { "get": { "operationId": "listPartyOpenItems", "summary": "List one party's open items", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyIdPath" }, { "$ref": "#/components/parameters/Direction" }, { "$ref": "#/components/parameters/OpenOnly" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/DueFrom" }, { "$ref": "#/components/parameters/DueTo" }, { "$ref": "#/components/parameters/CurrencyCode" }, { "$ref": "#/components/parameters/OverdueOnly" }, { "$ref": "#/components/parameters/OptionalAsOfDate" }, { "$ref": "#/components/parameters/Status" }], "responses": { "200": { "description": "Bounded open-item page" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/open-items/{openItemId}": { "get": { "operationId": "getOpenItem", "summary": "Get one open item in the selected legal entity", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/OpenItemId" }], "responses": { "200": { "description": "Open item" }, "404": { "$ref": "#/components/responses/NotFound" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/applications/suggest": { "post": { "operationId": "suggestApplications", "summary": "Return deterministic, explainable application suggestions", "requestBody": { "$ref": "#/components/requestBodies/AutoApplySuggestionQuery" }, "responses": { "200": { "description": "Suggestions and remaining source balance" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/applications/preview": { "post": { "operationId": "previewApplications", "summary": "Preview amounts, balances, versions, and settlement effects", "requestBody": { "$ref": "#/components/requestBodies/ApplyOpenItemsCommand" }, "responses": { "200": { "description": "Non-authoritative application preview" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/applications": { "post": { "operationId": "confirmApplications", "summary": "Confirm an application using the previewed open-item versions", "requestBody": { "$ref": "#/components/requestBodies/ApplyOpenItemsCommand" }, "responses": { "200": { "description": "Confirmed or idempotently replayed application batch" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/subledger/applications/{applicationId}/reverse": { "post": { "operationId": "reverseApplication", "summary": "Reverse an application with effective date and reason", "parameters": [{ "$ref": "#/components/parameters/ApplicationId" }], "requestBody": { "$ref": "#/components/requestBodies/ReverseApplicationCommand" }, "responses": { "200": { "description": "Reversal result" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/subledger/parties/{partyId}/financial-profile": { "get": { "operationId": "getFinancialProfile", "summary": "Read a party's legal-entity financial profile", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyIdPath" }], "responses": { "200": { "description": "Financial profile" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } }, "put": { "operationId": "updateFinancialProfile", "summary": "Update a party's financial profile", "parameters": [{ "$ref": "#/components/parameters/PartyIdPath" }], "requestBody": { "$ref": "#/components/requestBodies/UpdateFinancialProfileRequest" }, "responses": { "200": { "description": "Updated financial profile" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/subledger/parties/{partyId}/exposure": { "get": { "operationId": "getPartyExposure", "summary": "Read authoritative exposure for a party and legal entity", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyIdPath" }, { "$ref": "#/components/parameters/RequiredDirection" }, { "$ref": "#/components/parameters/OptionalAsOfDate" }], "responses": { "200": { "description": "Current exposure and available-credit result" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/reports/aging": { "get": { "operationId": "getAging", "summary": "Read current or historical aging by currency and date", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyId" }, { "$ref": "#/components/parameters/RequiredDirection" }, { "$ref": "#/components/parameters/AsOfDate" }, { "$ref": "#/components/parameters/CurrencyCode" }], "responses": { "200": { "description": "Aging buckets" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/parties/{partyId}/statement": { "get": { "operationId": "getPartyStatement", "summary": "Read a bounded, currency-aware statement page with running balances", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/PartyIdPath" }, { "$ref": "#/components/parameters/RequiredDirection" }, { "$ref": "#/components/parameters/FromDate" }, { "$ref": "#/components/parameters/ToDate" }, { "$ref": "#/components/parameters/CurrencyCode" }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 500 } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 } }], "responses": { "200": { "description": "Statement page and per-currency closing balance" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/write-off-policies": { "put": { "operationId": "updateWriteOffPolicy", "summary": "Update the legal entity's write-off policy", "requestBody": { "$ref": "#/components/requestBodies/UpdateWriteOffPolicyRequest" }, "responses": { "200": { "description": "Write-off policy" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/write-offs/requests": { "post": { "operationId": "createWriteOffRequest", "summary": "Request a controlled write-off", "requestBody": { "$ref": "#/components/requestBodies/CreateWriteOffCommand" }, "responses": { "200": { "description": "Write-off request" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/write-offs/requests/{requestId}/approve": { "post": { "operationId": "approveWriteOffRequest", "summary": "Approve a write-off request under separation-of-duties policy", "parameters": [{ "$ref": "#/components/parameters/RequestId" }, { "$ref": "#/components/parameters/LegalEntityId" }], "responses": { "200": { "description": "Write-off result" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/subledger/reports/control-reconciliation": { "post": { "operationId": "reconcileControlBalances", "summary": "Run a legal-entity control-account reconciliation", "requestBody": { "$ref": "#/components/requestBodies/ReconciliationQuery" }, "responses": { "200": { "description": "Persisted reconciliation and variance details" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/reconciliation/control-accounts": { "get": { "operationId": "listReconciliationControlAccounts", "summary": "List scoped control-account contexts from the Ledger contract", "parameters": [{ "$ref": "#/components/parameters/LegalEntityId" }, { "$ref": "#/components/parameters/AsOfDate" }], "responses": { "200": { "description": "Control-account contexts" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/reconciliation/run": { "post": { "operationId": "runReconciliation", "summary": "Run and persist a control-account reconciliation", "requestBody": { "$ref": "#/components/requestBodies/ReconciliationQuery" }, "responses": { "200": { "description": "Reconciliation result" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/reconciliation/runs/{runId}": { "get": { "operationId": "getReconciliationRun", "summary": "Read a reconciliation run in the legal entity", "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/LegalEntityId" }], "responses": { "200": { "description": "Persisted reconciliation run" }, "404": { "$ref": "#/components/responses/NotFound" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/opening-batches": { "post": { "operationId": "createOpeningBatch", "summary": "Create an opening subledger batch", "requestBody": { "$ref": "#/components/requestBodies/CreateOpeningSubledgerBatchCommand" }, "responses": { "200": { "description": "Opening batch" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/opening-batches/{batchId}/lines": { "post": { "operationId": "addOpeningBatchLines", "summary": "Add bounded opening lines to a draft batch", "parameters": [{ "$ref": "#/components/parameters/BatchId" }, { "$ref": "#/components/parameters/LegalEntityId" }], "requestBody": { "$ref": "#/components/requestBodies/OpeningSubledgerLines" }, "responses": { "200": { "description": "Added line count" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/subledger/opening-batches/{batchId}/validate": { "post": { "operationId": "validateOpeningBatch", "summary": "Validate opening batch totals against Ledger control balances", "parameters": [{ "$ref": "#/components/parameters/BatchId" }, { "$ref": "#/components/parameters/LegalEntityId" }], "responses": { "200": { "description": "Opening reconciliation validation" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/api/v1/subledger/opening-batches/{batchId}/finalize": { "post": { "operationId": "finalizeOpeningBatch", "summary": "Finalize a validated opening batch atomically", "parameters": [{ "$ref": "#/components/parameters/BatchId" }, { "$ref": "#/components/parameters/LegalEntityId" }], "responses": { "200": { "description": "Finalized opening batch" }, "400": { "$ref": "#/components/responses/DomainError" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/Conflict" } } } }
  },
  "components": {
    "parameters": {
      "LegalEntityId": { "name": "legalEntityId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "PartyId": { "name": "partyId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "PartyIdPath": { "name": "partyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "OpenItemId": { "name": "openItemId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "ApplicationId": { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "RequestId": { "name": "requestId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "BatchId": { "name": "batchId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Direction": { "name": "direction", "in": "query", "schema": { "type": "string", "enum": ["Receivable", "Payable"] } },
      "RequiredDirection": { "name": "direction", "in": "query", "required": true, "schema": { "type": "string", "enum": ["Receivable", "Payable"] } },
      "AsOfDate": { "name": "asOfDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
      "CurrencyCode": { "name": "currencyCode", "in": "query", "schema": { "type": "string", "pattern": "^[A-Z]{3}$" } },
      "FromDate": { "name": "fromDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
      "ToDate": { "name": "toDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
      "OpenOnly": { "name": "openOnly", "in": "query", "schema": { "type": "boolean", "default": true } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } },
      "Search": { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 120 } },
      "DueFrom": { "name": "dueFrom", "in": "query", "schema": { "type": "string", "format": "date" } },
      "DueTo": { "name": "dueTo", "in": "query", "schema": { "type": "string", "format": "date" } },
      "OverdueOnly": { "name": "overdueOnly", "in": "query", "schema": { "type": "boolean", "default": false } },
      "OptionalAsOfDate": { "name": "asOfDate", "in": "query", "schema": { "type": "string", "format": "date" } },
      "Status": { "name": "status", "in": "query", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "AutoApplySuggestionQuery": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "ApplyOpenItemsCommand": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "ReverseApplicationCommand": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "UpdateFinancialProfileRequest": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["legalEntityId", "expectedVersion"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "defaultReceivablePaymentTermId": { "type": ["string", "null"], "format": "uuid" }, "defaultPayablePaymentTermId": { "type": ["string", "null"], "format": "uuid" }, "creditLimitAmount": { "type": ["string", "null"] }, "creditLimitCurrency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }, "receivablePolicyCode": { "type": ["string", "null"] }, "payablePolicyCode": { "type": ["string", "null"] }, "expectedVersion": { "type": "integer", "minimum": 0 } } } } } },
      "UpdateWriteOffPolicyRequest": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["legalEntityId", "direction", "currencyCode", "maximumAmount", "approvalThreshold", "expectedVersion"], "properties": { "legalEntityId": { "type": "string", "format": "uuid" }, "direction": { "type": "string", "enum": ["Receivable", "Payable"] }, "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" }, "maximumAmount": { "type": "string" }, "approvalThreshold": { "type": "string" }, "expectedVersion": { "type": "integer", "minimum": 0 } } } } } },
      "CreateWriteOffCommand": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "ReconciliationQuery": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "CreateOpeningSubledgerBatchCommand": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
      "OpeningSubledgerLines": { "required": true, "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } }
    },
    "responses": {
      "DomainError": { "description": "ProblemDetails response with stable machine-readable code" },
      "PermissionDenied": { "description": "ProblemDetails response for missing scoped permission" },
      "NotFound": { "description": "ProblemDetails response for an unavailable record" },
      "Conflict": { "description": "ProblemDetails response for stale or conflicting financial state" }
    }
  }
}

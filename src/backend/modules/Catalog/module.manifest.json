{
  "$schema": "../../../../docs/platform/module-manifest-schema.json",
  "id": "catalog",
  "version": "1.0.0",
  "contractsVersion": 1,
  "layer": "L1",
  "type": "foundation",
  "purchasable": false,
  "scope": "tenant",
  "dependencies": { "hard": ["platform-kernel"], "optionalCapabilities": [] },
  "owns": { "schema": "foundation_catalog", "entities": ["product_template", "product_variant", "product_category", "brand", "uom_dimension", "uom", "product_uom", "product_barcode", "product_alias", "product_translation", "product_reference", "product_visibility", "catalog_search_projection"] },
  "permissions": ["catalog.product.read", "catalog.product.create", "catalog.product.edit", "catalog.product.archive", "catalog.category.manage", "catalog.brand.manage", "catalog.uom.manage", "catalog.barcode.manage", "catalog.reference.manage", "catalog.audit.view"],
  "capabilities": { "provides": ["catalog.product", "catalog.product-picker", "catalog.quantity-conversion"], "consumes": [] },
  "messaging": { "publishes": ["CatalogProductCreatedV1", "CatalogProductChangedV1", "CatalogProductArchivedV1", "CatalogProductRestoredV1", "CatalogProductUomChangedV1", "CatalogProductBarcodeChangedV1"], "consumes": [] },
  "lifecycle": { "supportsGoLive": true, "deactivationPolicy": "blocked_if_dependents" }
}
